FROM python:3.12-slim AS runtime

ARG GIT_COMMIT_SHA=unknown
ARG BUILD_TIMESTAMP=unknown

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    GIT_COMMIT_SHA=${GIT_COMMIT_SHA} \
    BUILD_TIMESTAMP=${BUILD_TIMESTAMP}

WORKDIR /app

RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid app --create-home --shell /usr/sbin/nologin app

COPY requirements-worker.txt /tmp/requirements-worker.txt
RUN python -m pip install --no-cache-dir --requirement /tmp/requirements-worker.txt

COPY --chown=app:app backend/services /app/backend/services
COPY --chown=app:app backend/__init__.py /app/backend/__init__.py
COPY --chown=app:app worker /app/worker
RUN mkdir -p /app/Software/data && chown -R app:app /app/Software

USER 10001:10001

CMD ["python", "-m", "worker.main"]
