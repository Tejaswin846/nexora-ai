[Unit]
Description=Nexora AI website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=azureuser
WorkingDirectory=/home/azureuser/nexora-ai/backend
Environment=NEXORA_PROVIDER=ollama
Environment=NEXORA_OLLAMA_MODE=primary
Environment=NEXORA_FORCE_OLLAMA_CHAT=true
Environment=NEXORA_FAST_MODEL=qwen3:14b
Environment=NEXORA_THINKING_MODEL=qwen3:14b
Environment=OLLAMA_URL=http://127.0.0.1:11434
Environment=NEXORA_OLLAMA_CONTEXT_TOKENS=1024
Environment=NEXORA_OLLAMA_INSTANT_MAX_TOKENS=80
Environment=NEXORA_OLLAMA_THINKING_MAX_TOKENS=160
Environment=NEXORA_IMAGE_PROVIDER=pollinations
Environment=NEXORA_HEALTH_DEEP=false
Environment=NEXORA_CACHE_FRONTEND_HTML=true
Environment=NEXORA_PERFORMANCE_LEVEL=balanced
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/azureuser/nexora-ai/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
