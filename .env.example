NEXORA_PROVIDER=auto
NEXORA_ADAPTIVE_MODEL_ROUTING=true
NEXORA_OLLAMA_MODE=fallback
NEXORA_FORCE_OLLAMA_CHAT=false
NEXORA_LOCK_QWEN=false
NEXORA_FAST_PROVIDER_ORDER=groq,gemini,openrouter,huggingface,pollinations
NEXORA_THINKING_PROVIDER_ORDER=gemini,openrouter,groq,huggingface,pollinations
NEXORA_PROVIDER_INSTANT_TIMEOUT=12
NEXORA_PROVIDER_THINKING_TIMEOUT=35
NEXORA_OLLAMA_INSTANT_TIMEOUT=25
NEXORA_OLLAMA_THINKING_TIMEOUT=75
NEXORA_OLLAMA_DISCOVERY_TIMEOUT=3
POLLINATIONS_TIMEOUT=8
POLLINATIONS_PRIMARY_TIMEOUT=6
POLLINATIONS_BACKUP_TIMEOUT=2
NEXORA_PUBLIC_APP_URL=https://your-public-nexora-url.example
NEXORA_CLERK_AUTH_REQUIRED=true

# Clerk authentication
CLERK_PUBLISHABLE_KEY=pk_test_or_live
CLERK_SECRET_KEY=sk_test_or_live
CLERK_JWT_ISSUER=https://your-clerk-issuer
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret

# Supabase database/storage. Use the project URL only; do not append /rest/v1.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional runtime tuning
NEXORA_DATA_DIR=backend/nexora_data
SUPABASE_STORAGE_TIMEOUT=12
CLERK_AUTH_TIMEOUT=10

# Optional protected Software SDK API keys.
# Installing the SDK does not require this; only protected cloud API calls do.
SOFTWARE_SDK_API_KEYS=dev-key
