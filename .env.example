NEXORA_PROVIDER=auto
NEXORA_ENV=development
NEXORA_LOG_LEVEL=INFO
NEXORA_AUTH_SECRET=change-me-in-production
NEXORA_PUBLIC_APP_URL=https://your-public-nexora-url.example
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
NEXORA_SUPABASE_AUTH_REQUIRED=true

# Supabase Auth
# Use the project URL only, for example https://abcdefgh.supabase.co
# Do not append /rest/v1.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Backend-only. Never expose this value in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Production safety.
# Required when NEXORA_ENV=production. Use your managed Postgres/Supabase DB URL.
DATABASE_URL=postgresql://user:password@host:5432/database

# Required for auth route protection in production/staging.
# If these are missing or broken in production, /auth/* fails closed.
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
NEXORA_AUTH_RATE_LIMIT_MAX_ATTEMPTS=20
NEXORA_AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Optional PostHog analytics and AI observability.
# Missing keys are safe: PostHog stays disabled and the app keeps running.
POSTHOG_ENABLED=true
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_AI_OBSERVABILITY_ENABLED=true
POSTHOG_SESSION_RECORDING_ENABLED=true
POSTHOG_PRIVACY_MODE=true

# Keep private by default. Set explicitly to true only if you want prompts or
# model responses sent to PostHog AI Observability.
POSTHOG_CAPTURE_PROMPTS=false
POSTHOG_CAPTURE_RESPONSES=false

# Optional Clerk variables. Supabase remains the current auth implementation
# unless Clerk-backed routes are explicitly enabled.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_ISSUER=
CLERK_WEBHOOK_SECRET=

# Optional runtime tuning
NEXORA_DATA_DIR=backend/nexora_data
NEXORA_AUTH_TOKEN_TTL_DAYS=30
SUPABASE_AUTH_TIMEOUT=12

# Developer onboarding wizard.
# /onboarding stores generated API keys as hashes. In development/test it uses
# the SQLite database under NEXORA_DATA_DIR when DATABASE_URL is empty.

# Optional protected Software SDK API keys.
# Installing the SDK does not require this; only protected cloud API calls do.
SOFTWARE_SDK_API_KEYS=dev-key

# Software SQLite storage is development/test only.
SOFTWARE_ENV=development
SOFTWARE_API_DB_PATH=Software/data/software_reliability.db
RELIABILITY_DB_PATH=Software/data/reliability.db

# Azure Pillar 1 staging. Use namespace FQDN, not a connection string.
ENVIRONMENT=development
APP_VERSION=0.1.0
PUBLIC_BASE_URL=http://127.0.0.1:8000
API_BASE_URL=http://127.0.0.1:8000
GIT_COMMIT_SHA=unknown
BUILD_TIMESTAMP=unknown
AZURE_SERVICE_BUS_NAMESPACE=
AZURE_SERVICE_BUS_QUEUE_NAME=workflow-jobs
AZURE_STORAGE_ACCOUNT_URL=
AZURE_CLIENT_ID=
APPROVED_GATEWAY_MODE=none
EXPECTED_AZURE_FRONT_DOOR_ID=
APIM_BACKEND_SHARED_SECRET=
STAGING_RATE_LIMIT_CALLS=120
STAGING_RATE_LIMIT_WINDOW_SECONDS=60
STAGING_MAX_REQUEST_BYTES=1048576
STAGING_REQUEST_TIMEOUT_SECONDS=60
REQUEST_LOG_SAMPLE_RATE=0.25
QDRANT_URL=
QDRANT_API_KEY=
SENTRY_DSN=
