NEXORA_PROVIDER=auto
NEXORA_PUBLIC_APP_URL=https://your-public-nexora-url.example
NEXORA_CLERK_AUTH_REQUIRED=true

# Clerk authentication
CLERK_PUBLISHABLE_KEY=pk_test_or_live
CLERK_SECRET_KEY=sk_test_or_live
CLERK_JWT_ISSUER=https://your-clerk-issuer
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret

# Supabase database/storage. Use the project URL only; do not append /rest/v1.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional runtime tuning
NEXORA_DATA_DIR=backend/nexora_data
SUPABASE_STORAGE_TIMEOUT=12
CLERK_AUTH_TIMEOUT=10

# Optional protected Software SDK API keys.
# Installing the SDK does not require this; only protected cloud API calls do.
SOFTWARE_SDK_API_KEYS=dev-key
