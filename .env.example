NEXORA_PROVIDER=auto
NEXORA_PUBLIC_APP_URL=https://your-public-nexora-url.example
NEXORA_SUPABASE_AUTH_REQUIRED=true

# Supabase Auth
# Use the project URL only, for example https://abcdefgh.supabase.co
# Do not append /rest/v1.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# Backend-only. Never expose this value in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional runtime tuning
NEXORA_DATA_DIR=backend/nexora_data
NEXORA_AUTH_TOKEN_TTL_DAYS=30
SUPABASE_AUTH_TIMEOUT=12

# Optional protected Software SDK API keys.
# Installing the SDK does not require this; only protected cloud API calls do.
SOFTWARE_SDK_API_KEYS=dev-key
